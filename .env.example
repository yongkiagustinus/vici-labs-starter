# --- Core ---
# Public base URL of the app (used for billing redirects, links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
# If omitted, a dev-only fallback is used (NOT safe for production).
AUTH_SECRET=

# --- Database (Postgres) ---
# If unset, the template falls back to an in-memory store so you can run with zero infra.
# Neon:     postgres://user:pass@ep-xxx.region.aws.neon.tech/db?sslmode=require
# Supabase: postgres://postgres:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=

# --- Billing (Stripe) ---
# Leave BILLING_PROVIDER=stub (default) to run without any Stripe account.
# Set to "stripe" and fill the keys below to enable real billing.
BILLING_PROVIDER=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Mobile subscriptions (StoreKit / Google Play IAP) ---
# Used by POST /api/finance/../billing/entitlement to verify in-app-purchase
# receipts. With BILLING_PROVIDER=stub these are ignored (any receipt grants
# entitlement so the paywall flow is exercisable locally). With
# BILLING_PROVIDER=stripe, mobile IAP is verified directly against Apple/Google.
# App Store shared secret (App Store Connect → App → App-Specific Shared Secret).
APPLE_IAP_SHARED_SECRET=
# Google Play: an OAuth access token for the Android Publisher API + the app's
# package name. (Mint the token from a service account in your backend.)
GOOGLE_PLAY_ACCESS_TOKEN=
ANDROID_PACKAGE_NAME=
